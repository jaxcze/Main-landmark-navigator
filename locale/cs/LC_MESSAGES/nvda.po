# Translators: Announced when there is no next main region on the page.
msgid "No next main region"
msgstr "Žádná další hlavní oblast"

# Translators: Announced when there is no previous main region on the page.
msgid "No previous main region"
msgstr "Žádná předchozí hlavní oblast"

# Translators: Description in the NVDA Input Gestures dialog.
msgid "Moves to the next main region on the web page"
msgstr "Přesune se na další hlavní oblast na webové stránce"

# Translators: Description in the NVDA Input Gestures dialog.
msgid "Moves to the previous main region on the web page"
msgstr "Přesune se na předchozí hlavní oblast na webové stránce"

# Translators: Fallback announced when main region found but full speech fails.
msgid "Main region"
msgstr "Hlavní oblast"
