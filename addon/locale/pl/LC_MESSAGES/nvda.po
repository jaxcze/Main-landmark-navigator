#. Translators: Announced when there is no next main region on the page.
#: addon/globalPlugins/mainLandmarkNavigator.py
msgid "No next main region"
msgstr "Brak następnego głównego punktu orientacyjnego"

#. Translators: Announced when there is no previous main region on the page.
#: addon/globalPlugins/mainLandmarkNavigator.py
msgid "No previous main region"
msgstr "Brak poprzedniego głównego punktu orientacyjnego"

#. Translators: Description shown in the NVDA Input Gestures dialog.
#: addon/globalPlugins/mainLandmarkNavigator.py
msgid "Moves to the next main landmark (main region) on the web page"
msgstr "Przechodzi do następnego głównego punktu orientacyjnego"

#. Translators: Description shown in the NVDA Input Gestures dialog.
#: addon/globalPlugins/mainLandmarkNavigator.py
msgid "Moves to the previous main landmark (main region) on the web page"
msgstr "Przechodzi do poprzedniego głównego punktu orientacyjnego"

#. Translators: Fallback announced when the main region is found but full speech output
#. fails.
#: addon/globalPlugins/mainLandmarkNavigator.py
msgid "Main region"
msgstr "Główny punkt orientacyjny"

#. Translators: Fallback category name used if NVDA's built-in Browse mode category cannot
#. be imported.
#: addon/globalPlugins/mainLandmarkNavigator.py
msgid "Browse mode"
msgstr "Tryb przeglądania"
